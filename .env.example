# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# These are read by src/pages/Contact.tsx. Vite INLINES them at build time,
# so a change here needs a rebuild, and on Render a change needs
# "Clear build cache & deploy" — see DEPLOY.md.
#
# Without them the contact form calls EmailJS with three undefined values and
# fails, and the visitor is told "Failed to send email" with no hint why.
#
# All three come from https://dashboard.emailjs.com

# Email Services → your service
VITE_EMAILJS_SERVICE_ID=

# Email Templates → your template
VITE_EMAILJS_TEMPLATE_ID=

# Account → API Keys → Public Key.
# Public by design: it ships inside the JS the browser downloads. What protects
# the account is the allowed-origins list in the EmailJS dashboard, not secrecy
# — so add the deployed domain there.
VITE_EMAILJS_PUBLIC_KEY=
